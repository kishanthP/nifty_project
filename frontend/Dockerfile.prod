# Production image: builds the web app, then serves it with Caddy
# (automatic HTTPS + forwards /api to the backend). Used by docker-compose.prod.yml.
FROM node:24-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

# Public settings baked into the JavaScript at build time (they come from .env).
ARG VITE_API_URL=""
ARG VITE_AUTH_DEV_MODE=false
ARG VITE_FIREBASE_API_KEY=""
ARG VITE_FIREBASE_AUTH_DOMAIN=""
ARG VITE_FIREBASE_PROJECT_ID=""
ARG VITE_FIREBASE_STORAGE_BUCKET=""
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=""
ARG VITE_FIREBASE_APP_ID=""
ARG VITE_FIREBASE_VAPID_KEY=""
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
