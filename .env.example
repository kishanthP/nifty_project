# =====================================================================
#  Share Market — configuration
#  Copy this file to ".env" (same folder) and fill in your values.
#  The .env file is git-ignored, so your secrets stay on your machine.
# =====================================================================

# ---------- General ----------
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
POSTGRES_USER=share_market
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=share_market
# Inside Docker the host is "postgres". For running the backend outside Docker use "localhost".
DATABASE_URL=postgresql+asyncpg://share_market:change_me_local_only@postgres:5432/share_market
TEST_DATABASE_URL=postgresql+asyncpg://share_market:change_me_local_only@postgres:5432/share_market_test

# ---------- Redis ----------
# Inside Docker the host is "redis". Outside Docker use "localhost".
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/15

# ---------- Market data ----------
# mock     = fake prices that move every second (test alerts any time, even at night)
# angelone = real-time NSE data from Angel One SmartAPI (needs the 4 values below)
# yahoo    = free delayed data, no account needed
MARKET_DATA_PROVIDER=mock
# Optional: used automatically if the main provider stops sending prices during market hours
FALLBACK_PROVIDER=
FALLBACK_AFTER_SECONDS=60

# Angel One SmartAPI (https://smartapi.angelone.in) — fill these yourself
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# ---------- Firebase (backend) ----------
# Path INSIDE the container. Put the downloaded file at backend/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-service-account.json
# true = allow "dev login" with just an email (for local testing before Firebase is set up).
# Must be false in production — the API refuses to start otherwise.
AUTH_DEV_MODE=true

# Port the API is published on (on your computer). If 8000 is busy, use e.g. 8001
# and change VITE_API_URL below to match.
API_PORT=8000

# ---------- Firebase (frontend, public web config — safe to expose) ----------
VITE_API_URL=http://localhost:8000
VITE_AUTH_DEV_MODE=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase console → Project settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=
